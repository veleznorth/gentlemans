// File name: projects/2/FullAdder.hdl
/**
 * Computes the sum of three bits.
 * Two HalfAdders are chained: the first one adds a + b, the second one
 * adds the resulting sum to c. Only one of the two carries can be 1,
 * so an Or is enough to combine them.
 */
CHIP FullAdder {
    IN a, b, c;
    OUT sum, carry;

    PARTS:
    HalfAdder(a=a, b=b, sum=sumAB, carry=carryAB);
    HalfAdder(a=sumAB, b=c, sum=sum, carry=carryABC);

    Or(a=carryAB, b=carryABC, out=carry);
}
